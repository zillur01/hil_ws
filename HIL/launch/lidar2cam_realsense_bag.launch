<launch>

  <param name="/use_sim_time" value="true"/>

  <node
    name="play" 
    pkg="rosbag" 
    type="play" 
    args="$(find HIL)/data/Realsense_rosbags/sample_1.bag 
            /camera/depth/color/points:=/cloud 
            /camera/color/camera_info:=/camera_info
            /camera/color/image_raw:=/rgb
            /tf_static:=/tf
            --delay=5 --clock"
  />

  <node 
    name="pointcloud2_to_pcd" 
    pkg="pcl_ros"
    type="pointcloud_to_pcd" 
    args="input:=/cloud _prefix:=/$(find HIL)/data/pcd_data/"
  />

  <node 
    name="realsense_projector" 
    pkg="HIL" 
    type="project_realsense.py" 
    output="screen"
  />

</launch>