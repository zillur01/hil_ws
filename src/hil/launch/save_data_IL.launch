<launch>
  <arg name="input_bag_path" default="/media/bhargav/03E7-EC27/cone_bags/cone2_2022-12-12-16-30-37.bag"/>
  <param name="/use_sim_time" value="true"/>
  <node
    name="play" 
    pkg="rosbag" 
    type="play" 
    args="$(arg input_bag_path)
            --clock --rate=1
            --delay=0.25"
  />

  <!-- <include file="$(find hil)/launch/base.launch"/> -->

  <node 
    name="save_data_node" pkg="hil" 
    type="save_data_node_IL.py" output="screen">
    <remap from="/camera_info" to="/zed2/zed_node/left/camera_info"/>
    <remap from="/cloud" to="/lidar1/velodyne_points"/>
    <remap from="/rgb" to="/zed2/zed_node/left/image_rect_color"/>
    <remap from="/gps" to="/novatel/inspva"/>
    <param name="input_bag_path" value="$(arg input_bag_path)" /> 
   </node>

</launch>