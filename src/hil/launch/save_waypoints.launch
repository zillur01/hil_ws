<launch>
    <arg name="csv_name" default="cone2"/>
    <arg name="use_bag" default="0"/>
    <group if="$(eval arg('use_bag') ==1)">
        <param name="/use_sim_time" value="true"/>
        <node
        name="play" 
        pkg="rosbag" 
        type="play" 
        args="$(find hil)/data/GEM_rosbags/cone2_2022-12-12-16-30-37.bag
                --clock
                --delay=1"
        />
    </group>
    

    <node 
        name="save_waypoint_node" pkg="hil" 
        type="save_waypoint_node.py" output="screen">
        <param name="filename" value="$(arg csv_name)" /> 
    </node>
</launch>
