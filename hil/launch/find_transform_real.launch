<launch>

  <param name="/use_sim_time" value="true"/>
  <node
    name="play" 
    pkg="rosbag" 
    type="play" 
    args="$(find hil)/data/GEM_rosbags/marker_static.bag
            /lidar1/velodyne_points:=/cloud
            /zed2/zed_node/left/camera_info:=/camera_info
            /zed2/zed_node/left/image_rect_color:=/rgb
            --clock --loop
            --delay=1"
  />
  <node name="aruco_markers" pkg="hil" 
    type="aruco_markers.py">
    <remap from="/camera_info" to="/zed2/zed_node/left/camera_info"/>
    <remap from="/cloud" to="/lidar1/velodyne_points"/>
    <remap from="/rgb" to="/zed2/zed_node/left/image_rect_color"/>
  </node>

  <rosparam command="load" file="$(find lidar_camera_calibration)/conf/lidar_camera_calibration.yaml" />
  <node pkg="lidar_camera_calibration" type="find_transform" name="find_transform" output="screen">
    <remap from="/camera_info" to="/zed2/zed_node/left/camera_info"/>
    <remap from="/cloud" to="/lidar1/velodyne_points"/>
    <remap from="/rgb" to="/zed2/zed_node/left/image_rect_color"/>
  </node>

</launch>